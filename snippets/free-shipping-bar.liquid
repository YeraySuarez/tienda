{%- if settings.cart_show_free_shipping and settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign percent = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
  -%}
  <div class="cart__shipping">
    {%- if remaining > 0 -%}
      {{ 'cart.general.free_shipping_remaining' | t: amount: remaining_money }}
    {%- else -%}
      {{ 'cart.general.free_shipping_reached' | t }}
    {%- endif -%}
    <div class="cart__shipping-bar"><span style="width: {{ percent }}%;"></span></div>
  </div>
{%- endif -%}
