[
  {
    "name": "theme_info",
    "theme_name": "Tienda",
    "theme_version": "1.0.0",
    "theme_author": "Tienda",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Logo y favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 x 32 px recomendado"
      },
      {
        "type": "checkbox",
        "id": "show_loading_screen",
        "label": "Mostrar pantalla de carga con logo",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "loading_logo",
        "label": "Logo de la pantalla de carga"
      }
    ]
  },
