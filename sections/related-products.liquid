{%- comment -%}
  Pestañas "También te puede gustar" (Product Recommendations API)
  y "Vistos recientemente" (guardado en el navegador).
{%- endcomment -%}
<div
  class="related-products section-padding"
  style="--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px; --COLUMNS: {{ section.settings.columns }}; --COLUMNS-GRID: {{ section.settings.columns | round }}; --COLUMNS-MEDIUM: 3; --visible-mobile: 1.6;"
  data-tabs
  data-related
  data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  data-product-handle="{{ product.handle }}"
  data-limit="{{ section.settings.limit }}"
>
  <div class="tabs-collections__nav related-products__nav" role="tablist">
    <button type="button" role="tab" class="tabs-collections__tab is-active" aria-selected="true">{{ section.settings.title | escape }}</button>
    {%- if section.settings.show_recently_viewed -%}
      <button type="button" role="tab" class="tabs-collections__tab" aria-selected="false" data-recent-tab hidden>{{ section.settings.recent_title | escape }}</button>
    {%- endif -%}
  </div>

  <div class="tabs-collections__panel is-active" role="tabpanel">
    <div class="product-slider{% if section.settings.full_width %} product-slider--full{% endif %}" data-product-slider>
      <div class="product-slider__track" data-recommendations>
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          {%- for product in recommendations.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button type="button" class="product-slider__arrow product-slider__arrow--prev" aria-label="{{ 'general.slider.previous' | t }}">
        {%- render 'icon', icon: 'chevron-left' -%}
      </button>
      <button type="button" class="product-slider__arrow product-slider__arrow--next" aria-label="{{ 'general.slider.next' | t }}">
        {%- render 'icon', icon: 'chevron-right' -%}
      </button>
    </div>
  </div>

  {%- if section.settings.show_recently_viewed -%}
    <div class="tabs-collections__panel" role="tabpanel">
      <div class="product-slider{% if section.settings.full_width %} product-slider--full{% endif %}" data-product-slider>
        <div class="product-slider__track" data-recently-viewed></div>
        <button type="button" class="product-slider__arrow product-slider__arrow--prev" aria-label="{{ 'general.slider.previous' | t }}">
          {%- render 'icon', icon: 'chevron-left' -%}
        </button>
        <button type="button" class="product-slider__arrow product-slider__arrow--next" aria-label="{{ 'general.slider.next' | t }}">
          {%- render 'icon', icon: 'chevron-right' -%}
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Productos relacionados",
  "class": "section-related-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "También te puede gustar:"
    },
    {
      "type": "checkbox",
      "id": "show_recently_viewed",
      "label": "Mostrar pestaña de vistos recientemente",
      "default": true
    },
    {
      "type": "text",
      "id": "recent_title",
      "label": "Título de vistos recientemente",
      "default": "Vistos recientemente"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Número de productos",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Productos visibles (escritorio)",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "default": 3.5
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Carrusel a todo el ancho",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Productos relacionados"
    }
  ]
}
{% endschema %}
