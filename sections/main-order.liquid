<div class="account account--wide">
  <h1 class="heading-small">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="text-center" style="margin-bottom: 30px;">
    {{ order.created_at | time_tag: format: 'date_at_time' }} ·
    <a href="{{ routes.account_url }}" class="btn btn--text">{{ 'customer.account.return' | t }}</a>
  </p>
  {%- if order.cancelled -%}
    {%- assign cancelled_date = order.cancelled_at | date: '%d/%m/%Y' -%}
    <p class="form-message">{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
  {%- endif -%}
  <div class="account-grid">
    <table class="account-table">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title | link_to: line_item.product.url }}
              {%- if line_item.fulfillment -%}
                <br><small>{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}
                {%- if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ 'customer.order.track' | t }}</a>{% endif -%}
                </small>
              {%- endif -%}
            </td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="2">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr><td colspan="2">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr><td colspan="2">{{ tax_line.title }} ({{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>
        {%- endfor -%}
        <tr><td colspan="2"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_price | money }}</strong></td></tr>
      </tfoot>
    </table>
    <div>
      <h2 class="heading-x-small" style="margin-bottom: 10px;">{{ 'customer.order.billing_address' | t }}</h2>
      {{ order.billing_address | format_address }}
      <h2 class="heading-x-small" style="margin: 20px 0 10px;">{{ 'customer.order.shipping_address' | t }}</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Pedido", "class": "section-main-order", "settings": [] }
{% endschema %}
