<article class="wrapper--narrow page-content">
  <div class="page-header">
    <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="heading-small">{{ article.title | escape }}</h1>
  </div>
  {%- if article.image -%}
    <div class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 780px) 780px, 100vw', alt: article.title }}
    </div>
  {%- endif -%}
  <div class="rte body-medium">{{ article.content }}</div>
  <p style="margin-top: 40px;">
    <a href="{{ blog.url }}" class="btn btn--text">&larr; {{ 'blogs.article.back' | t: title: blog.title }}</a>
  </p>
</article>

{% schema %}
{
  "name": "Artículo",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
