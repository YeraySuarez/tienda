{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="collection-carousel section-padding"
  style="
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --slide-gap: {{ section.settings.slide_gap }}px;
    --slide-border-radius: {{ section.settings.border_radius }}px;
    --per-view: {{ section.settings.per_view }};
    --per-view-mobile: {{ section.settings.per_view_mobile }};
    --media-height: {{ section.settings.media_height }}px;
    --media-height-mobile: {{ section.settings.media_height_mobile }}px;
    --cta-color: {{ section.settings.cta_color }};
    --cta-bg-color: {{ section.settings.cta_bg_color }};
    --cta-hover-color: {{ section.settings.cta_hover_color }};
    --cta-hover-bg-color: {{ section.settings.cta_hover_bg_color }};
    --overlay-color: {{ section.settings.overlay_color }};
    --overlay-opacity: {{ overlay_opacity }};
    --section-background: {{ section.settings.section_background }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --heading-size: {{ section.settings.heading_size }}px;
  "
  data-collection-carousel
  data-loop="{{ section.settings.loop }}"
  data-autoplay="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed }}{% else %}0{% endif %}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header text-{{ section.settings.heading_align }}">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="section-description">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="carousel-container">
      <div class="carousel-track">
        <div class="carousel-wrapper">
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign image = block.settings.image | default: collection.featured_image
              assign label = block.settings.label | default: collection.title | default: 'Colección'
              assign url = block.settings.link | default: collection.url | default: '#'
            -%}
            <div class="carousel-slide" {{ block.shopify_attributes }}>
              <a href="{{ url }}" class="collection-link">
                <div class="collection-media">
                  {%- if image != blank -%}
                    {{
                      image
                      | image_url: width: 900
                      | image_tag:
                        widths: '400, 600, 800, 900',
                        sizes: '(min-width: 750px) 25vw, 90vw',
                        loading: 'lazy',
                        class: 'collection-image',
                        alt: label
                    }}
                  {%- else -%}
                    {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                    {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  <div class="collection-overlay"></div>
                  <div class="collection-content">
                    <span class="collection-cta">{{ label | escape }}</span>
                  </div>
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <button type="button" class="carousel-nav-button carousel-nav-prev" aria-label="{{ 'general.slider.previous' | t }}">
        {%- render 'icon', icon: 'chevron-left' -%}
      </button>
      <button type="button" class="carousel-nav-button carousel-nav-next" aria-label="{{ 'general.slider.next' | t }}">
        {%- render 'icon', icon: 'chevron-right' -%}
      </button>
    </div>
    {%- if section.settings.show_dots -%}
      <div class="carousel-pagination"></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrusel de colecciones",
  "class": "section-collection-carousel",
  "max_blocks": 20,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Descubre nuestras colecciones"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Encuentra tu estilo en cada categoría</p>"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación del título",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "header",
      "content": "Carrusel"
    },
    {
      "type": "range",
      "id": "per_view",
      "label": "Colecciones visibles (escritorio)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "per_view_mobile",
      "label": "Colecciones visibles (móvil)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "Altura de imagen (escritorio)",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "Altura de imagen (móvil)",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "slide_gap",
      "label": "Separación",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Redondeo de esquinas",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Volver al principio al llegar al final",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar puntos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducción automática",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Cambiar cada",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Fondo de la sección",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Título",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Descripción",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Capa sobre la imagen",
      "default": "#221e1e"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad de la capa",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Botón — texto",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "cta_bg_color",
      "label": "Botón — fondo",
      "default": "rgba(133, 133, 133, 0.7)"
    },
    {
      "type": "color",
      "id": "cta_hover_color",
      "label": "Botón — texto al pasar el ratón",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cta_hover_bg_color",
      "label": "Botón — fondo al pasar el ratón",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Si se deja vacía, usa la imagen de la colección."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto del botón",
          "info": "Si se deja vacío, usa el nombre de la colección."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace personalizado"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrusel de colecciones",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
