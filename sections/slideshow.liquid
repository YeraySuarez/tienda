{%- liquid
  case section.settings.height
    when 'full'
      assign h = '100svh'
    when 'three-quarters'
      assign h = '75svh'
    when 'two-thirds'
      assign h = '66.666svh'
    when 'half'
      assign h = '50svh'
  endcase
  case section.settings.height_mobile
    when 'full'
      assign hm = '100svh'
    when 'three-quarters'
      assign hm = '75svh'
    when 'two-thirds'
      assign hm = '66.666svh'
    when 'half'
      assign hm = '50svh'
  endcase
-%}

<div
  class="slideshow{% if section.settings.transition == 'slide' %} slideshow--slide{% endif %}"
  style="--slide-height: {{ h }}; --slide-height-mobile: {{ hm }};"
  data-slideshow
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign image = block.settings.image
        assign image_mobile = block.settings.image_mobile | default: image
        assign desktop_focal = image.presentation.focal_point | default: 'center'
        assign mobile_focal = image_mobile.presentation.focal_point | default: 'center'
        assign img_class = 'slide-img-' | append: block.id
      -%}
      <div
        class="slideshow__slide{% if forloop.first %} is-active{% endif %}"
        role="group"
        aria-roledescription="slide"
        aria-label="{{ forloop.index }} / {{ forloop.length }}"
        aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        style="--slide-text: {{ block.settings.text_color }};"
        {{ block.shopify_attributes }}
      >
        <a
          class="slideshow__media"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          tabindex="-1"
          aria-hidden="true"
        >
          {%- if image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ image_mobile | image_url: width: 750 }} 750w, {{ image_mobile | image_url: width: 1100 }} 1100w, {{ image_mobile | image_url: width: 1500 }} 1500w"
                  sizes="100vw"
                >
              {%- endif -%}
              {%- liquid
                if forloop.first
                  assign loading = 'eager'
                else
                  assign loading = 'lazy'
                endif
              -%}
              {{
                image
                | image_url: width: 3000
                | image_tag:
                  widths: '750, 1100, 1500, 1800, 2200, 3000',
                  sizes: '100vw',
                  loading: loading,
                  fetchpriority: 'auto',
                  alt: image.alt,
                  class: img_class
              }}
            </picture>
            <style>
              .{{ img_class }} { object-position: {{ desktop_focal }}; }
              @media (max-width: 749px) {
                .{{ img_class }} { object-position: {{ mobile_focal }}; }
              }
            </style>
          {%- else -%}
            {%- assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1 -%}
            {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>

        {%- if block.settings.overlay_style == 'radial' -%}
          <div class="slideshow__overlay slideshow__overlay--radial"></div>
        {%- elsif block.settings.overlay_opacity > 0 -%}
          <div class="slideshow__overlay" style="--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
        {%- endif -%}

        <div class="slideshow__content align--{{ block.settings.text_position }}">
          {%- if block.settings.subheading != blank -%}
            <p class="subheading" style="margin-bottom: 8px;">{{ block.settings.subheading | escape }}</p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2 class="slideshow__title {{ block.settings.title_size }}">{{ block.settings.title }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="slideshow__text body-large">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <div>
              <a href="{{ block.settings.link | default: '#' }}" class="btn {{ block.settings.button_style }}">
                {{- block.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button type="button" class="slideshow__arrow slideshow__arrow--prev" aria-label="{{ 'general.slider.previous' | t }}">
        {%- render 'icon', icon: 'chevron-left' -%}
      </button>
      <button type="button" class="slideshow__arrow slideshow__arrow--next" aria-label="{{ 'general.slider.next' | t }}">
        {%- render 'icon', icon: 'chevron-right' -%}
      </button>
    {%- endif -%}
    {%- if section.settings.show_dots -%}
      <div class="slideshow__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="slideshow__dot{% if forloop.first %} is-active{% endif %}"
            aria-label="{{ 'sections.slideshow.slide' | t }} {{ forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          >
            {{ forloop.index }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Slideshow",
  "class": "section-slideshow",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Altura (escritorio)",
      "options": [
        { "value": "full", "label": "Pantalla completa" },
        { "value": "three-quarters", "label": "3/4 de pantalla" },
        { "value": "two-thirds", "label": "2/3 de pantalla" },
        { "value": "half", "label": "Media pantalla" }
      ],
      "default": "two-thirds"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Altura (móvil)",
      "options": [
        { "value": "full", "label": "Pantalla completa" },
        { "value": "three-quarters", "label": "3/4 de pantalla" },
        { "value": "two-thirds", "label": "2/3 de pantalla" },
        { "value": "half", "label": "Media pantalla" }
      ],
      "default": "two-thirds"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transición",
      "options": [
        { "value": "slide", "label": "Deslizar" },
        { "value": "fade", "label": "Fundido" }
      ],
      "default": "slide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducción automática",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Cambiar cada",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar puntos",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Descripción para accesibilidad",
      "default": "Slideshow"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen para móvil (opcional)"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Antetítulo"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Título",
          "default": "NUEVA COLECCIÓN"
        },
        {
          "type": "select",
          "id": "title_size",
          "label": "Tamaño del título",
          "options": [
            { "value": "heading-small", "label": "Pequeño" },
            { "value": "heading-medium", "label": "Mediano" },
            { "value": "heading-large", "label": "Grande" },
            { "value": "heading-x-large", "label": "Muy grande" }
          ],
          "default": "heading-small"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Disponible ahora</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "SHOP"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (botón e imagen)"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Estilo del botón",
          "options": [
            { "value": "btn--white", "label": "Blanco" },
            { "value": "btn--black", "label": "Negro" },
            { "value": "btn--white btn--outline", "label": "Contorno blanco" },
            { "value": "btn--secondary", "label": "Secundario" },
            { "value": "btn--text", "label": "Texto subrayado" }
          ],
          "default": "btn--white"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Posición del texto",
          "options": [
            { "value": "top-left", "label": "Arriba izquierda" },
            { "value": "top-center", "label": "Arriba centro" },
            { "value": "top-right", "label": "Arriba derecha" },
            { "value": "middle-left", "label": "Centro izquierda" },
            { "value": "middle-center", "label": "Centro" },
            { "value": "middle-right", "label": "Centro derecha" },
            { "value": "bottom-left", "label": "Abajo izquierda" },
            { "value": "bottom-center", "label": "Abajo centro" },
            { "value": "bottom-right", "label": "Abajo derecha" }
          ],
          "default": "middle-center"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color del texto",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "overlay_style",
          "label": "Oscurecer imagen",
          "options": [
            { "value": "radial", "label": "Degradado radial" },
            { "value": "solid", "label": "Capa uniforme" }
          ],
          "default": "radial"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Opacidad de la capa uniforme",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
