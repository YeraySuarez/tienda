<div
  class="section-columns section-padding"
  style="--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px;{% if section.settings.color_bg != blank %} background: {{ section.settings.color_bg }};{% endif %}"
>
  <div class="wrapper--full-padded">
    {%- if section.settings.title != blank -%}
      <div class="grid__heading-holder">
        <h2 class="heading-small">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div
      class="multicolumn text-{{ section.settings.text_align }}"
      style="--COLUMNS: {{ section.blocks.size | at_most: section.settings.columns | at_least: 1 }}; --COLUMNS-MOBILE: {{ section.settings.columns_mobile }};"
    >
      {%- for block in section.blocks -%}
        <div class="column animate-on-scroll" {{ block.shopify_attributes }}>
          <div class="column__inner" style="--icon-size: {{ block.settings.icon_size }}px;">
            {%- if block.settings.image != blank -%}
              <div class="column__image" style="width: {{ block.settings.icon_size }}px;">
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy' }}
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="column__icon">
                {%- render 'icon', icon: block.settings.icon -%}
              </div>
            {%- endif -%}
            <div class="column__content">
              {%- if block.settings.title != blank -%}
                <h3 class="column__heading heading-x-small">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="column__text rte body-medium">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link | default: '#' }}" class="btn btn--text btn--small" style="margin-top: 10px;">{{ block.settings.link_label | escape }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Multicolumna",
  "class": "section-multicolumn",
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas máximas (escritorio)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas (móvil)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Color de fondo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "truck", "label": "Camión (envío)" },
            { "value": "star", "label": "Estrella" },
            { "value": "heart", "label": "Corazón" },
            { "value": "gift", "label": "Regalo" },
            { "value": "return", "label": "Devolución" },
            { "value": "lock", "label": "Candado (pago seguro)" },
            { "value": "chat", "label": "Chat" },
            { "value": "leaf", "label": "Hoja" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen personalizada (sustituye al icono)"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Tamaño del icono",
          "min": 16,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 20
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Título",
          "default": "Envío internacional"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Con packaging cuidado</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texto del enlace"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumna",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
