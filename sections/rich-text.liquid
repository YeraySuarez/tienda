<section
  class="rich-text section-padding"
  style="--PT: {{ section.settings.padding_top }}px; --PB: {{ section.settings.padding_bottom }}px;{% if section.settings.color_bg != blank %} background: {{ section.settings.color_bg }};{% endif %}"
>
  <div class="wrapper--full-padded">
    <div class="rich-text__content text-{{ section.settings.text_align }}" style="--content-width: {{ section.settings.content_width }}px;">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subheading' -%}
            <p class="rich-text__subheading subheading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </h2>
          {%- when 'text' -%}
            <div class="rte body-medium" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <div {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}" class="btn {{ block.settings.style }}">{{ block.settings.label | escape }}</a>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Texto enriquecido",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Ancho máximo del contenido",
      "min": 300,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Color de fondo"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Antetítulo",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "ETIQUÉTANOS EN"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Título",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "@tumarca"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tamaño",
          "options": [
            { "value": "heading-small", "label": "Pequeño" },
            { "value": "heading-medium", "label": "Mediano" },
            { "value": "heading-large", "label": "Grande" }
          ],
          "default": "heading-small"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Comparte tus looks con nosotras.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Botón",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "Ver más"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Estilo",
          "options": [
            { "value": "btn--primary", "label": "Principal" },
            { "value": "btn--secondary", "label": "Secundario" },
            { "value": "btn--outline", "label": "Contorno" },
            { "value": "btn--text", "label": "Texto subrayado" }
          ],
          "default": "btn--primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texto enriquecido",
      "blocks": [
        { "type": "subheading" },
        { "type": "heading" }
      ]
    }
  ]
}
{% endschema %}
