{%- liquid
  assign blocks_count = section.blocks.size
  assign is_ticker = false
  if section.settings.mode == 'ticker'
    assign is_ticker = true
  endif
-%}

{%- if blocks_count > 0 -%}
  <div
    class="announcement{% if is_ticker %} announcement--ticker announcement--{{ section.settings.ticker_direction }}{% endif %}"
    style="--COLOR-BG: {{ section.settings.color_bg }}; --COLOR-TEXT: {{ section.settings.color_text }}; --ticker-speed: {{ section.settings.ticker_speed }}s;"
    {% if is_ticker == false and blocks_count > 1 %}
      data-announcement-slider data-speed="{{ section.settings.slide_speed | times: 1000 }}"
    {% endif %}
    {{ section.shopify_attributes }}
  >
    <div class="announcement__bar">
      {%- if is_ticker -%}
        <div class="announcement__ticker" aria-label="{{ section.blocks.first.settings.text | strip_html | escape }}">
          {%- for i in (1..2) -%}
            {%- for n in (1..4) -%}
              {%- for block in section.blocks -%}
                <div class="announcement__ticker-item" {% if i > 1 or n > 1 %}aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="announcement__slides">
          {%- for block in section.blocks -%}
            <div class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Estilo",
      "options": [
        { "value": "ticker", "label": "Texto en movimiento" },
        { "value": "slider", "label": "Mensajes rotativos" }
      ],
      "default": "ticker"
    },
    {
      "type": "select",
      "id": "ticker_direction",
      "label": "Dirección del movimiento",
      "options": [
        { "value": "rtl", "label": "Derecha a izquierda" },
        { "value": "ltr", "label": "Izquierda a derecha" }
      ],
      "default": "rtl"
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "label": "Duración de una vuelta",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "range",
      "id": "slide_speed",
      "label": "Tiempo entre mensajes",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fondo",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texto",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anuncio",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratuito en pedidos superiores a 250 €"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
