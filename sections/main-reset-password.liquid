<div class="account">
  <h1 class="heading-small">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPassword">{{ 'customer.login.password' | t }}</label><input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password"></div>
    <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.reset_password.confirm' | t }}</label><input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password"></div>
    <button type="submit" class="btn btn--full">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Restablecer contraseña", "class": "section-main-reset-password", "settings": [] }
{% endschema %}
