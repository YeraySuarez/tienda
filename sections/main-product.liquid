{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign preorder_tag = settings.badge_preorder_tag | downcase | strip
  assign is_preorder = false
  for tag in product.tags
    assign tag_down = tag | downcase | strip
    if preorder_tag != blank and tag_down == preorder_tag
      assign is_preorder = true
    endif
  endfor
  if product.metafields.custom.preorder == true
    assign is_preorder = true
  endif
  assign color_names = settings.swatch_option_names | downcase | split: ','
-%}

<section
  class="product-section"
  data-product
  data-update-url
  data-preorder="{{ is_preorder }}"
>
  <div class="product">
    {%- comment -%} Galería {%- endcomment -%}
    <div class="product__media">
      <div class="product__media-list{% if product.media.size < 2 %} product__media-list--single{% endif %}">
        {%- for media in product.media -%}
          <div class="product__media-item" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  if forloop.first
                    assign loading = 'eager'
                  else
                    assign loading = 'lazy'
                  endif
                  assign media_alt = media.alt | default: product.title
                -%}
                {{
                  media
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: '(min-width: 990px) 30vw, 100vw',
                    loading: loading,
                    alt: media_alt
                }}
              {%- when 'video' -%}
                {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="product__media-item">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__media-dots" aria-hidden="true">
          {%- for media in product.media -%}
            <span{% if forloop.first %} class="is-active"{% endif %}></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Información {%- endcomment -%}
    <div class="product__info">
      <div class="product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              <p class="product__vendor subheading" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

            {%- when 'title' -%}
              <div class="product__title-row" {{ block.shopify_attributes }}>
                <h1 class="product__title">{{ product.title | escape }}</h1>
                {%- if settings.show_wishlist -%}
                  <button type="button" class="product__wishlist" data-wishlist-toggle="{{ product.handle }}" aria-pressed="false" aria-label="{{ 'products.product.wishlist' | t }}">
                    {%- render 'icon', icon: 'bookmark' -%}
                  </button>
                {%- endif -%}
              </div>

            {%- when 'siblings' -%}
              {%- assign siblings = product.metafields.custom.siblings.value -%}
              {%- if siblings != blank -%}
                <div class="product__siblings" {{ block.shopify_attributes }}>
                  <p class="product__siblings-label">{{ product.metafields.custom.color_name | default: block.settings.label }}</p>
                  <div class="product__siblings-list">
                    {%- assign current_in_list = false -%}
                    {%- for sibling in siblings -%}
                      {%- if sibling.id == product.id %}{% assign current_in_list = true %}{% endif -%}
                    {%- endfor -%}
                    {%- unless current_in_list -%}
                      <span class="product__sibling is-active" title="{{ product.title | escape }}">
                        {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
                      </span>
                    {%- endunless -%}
                    {%- for sibling in siblings -%}
                      <a href="{{ sibling.url }}" class="product__sibling{% if sibling.id == product.id %} is-active{% endif %}" title="{{ sibling.title | escape }}">
                        {{ sibling.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: sibling.title }}
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                <div data-product-price>
                  {%- render 'price', variant: current_variant -%}
                </div>
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <p class="product__tax">
                    {%- if cart.taxes_included %}{{ 'products.product.taxes_included' | t }}{% endif -%}
                    {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{% endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_down = option.name | downcase | strip
                      assign is_color = false
                      for n in color_names
                        assign n_clean = n | strip
                        if option_down == n_clean
                          assign is_color = true
                        endif
                      endfor
                      assign use_dropdown = false
                      if block.settings.picker_style == 'dropdown' and is_color == false
                        assign use_dropdown = true
                      endif
                      assign needs_choice = false
                      if use_dropdown and block.settings.require_selection and option.values.size > 1
                        assign needs_choice = true
                        assign must_choose = true
                      endif
                    -%}
                    {%- if use_dropdown -%}
                      {%- assign select_id = section.id | append: '-select-' | append: option.position -%}
                      <div class="variant-picker__dropdown" data-option-index="{{ forloop.index0 }}">
                        <label for="{{ select_id }}">{{ option.name | escape }}:</label>
                        <select id="{{ select_id }}" name="{{ option.name | escape }}" data-option-select>
                          {%- if needs_choice -%}
                            {%- assign option_lower = option.name | downcase -%}
                            <option value="" selected disabled>{{ 'products.product.select_option' | t: option: option_lower }}</option>
                          {%- endif -%}
                          {%- for value in option.values -%}
                            <option value="{{ value | escape }}"{% if needs_choice == false and option.selected_value == value %} selected{% endif %}>
                              {{- value | escape -}}{%- unless value.available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    {%- else -%}
                      <fieldset data-option-index="{{ forloop.index0 }}">
                        <legend>{{ option.name | escape }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span></legend>
                        <div class="variant-picker__values">
                          {%- for value in option.values -%}
                            {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                            <input
                              type="radio"
                              id="{{ input_id }}"
                              name="{{ option.name | escape }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              {% unless value.available %}class="is-unavailable"{% endunless %}
                            >
                            {%- if is_color and block.settings.color_swatches -%}
                              {%- liquid
                                assign swatch_bg = value | handle | replace: '-', ''
                                if value.swatch.color
                                  assign swatch_bg = value.swatch.color
                                endif
                              -%}
                              <label
                                for="{{ input_id }}"
                                class="swatch-label"
                                title="{{ value | escape }}"
                                style="--swatch: {{ swatch_bg }};{% if value.swatch.image %} --swatch: url('{{ value.swatch.image | image_url: width: 80 }}');{% endif %}"
                              >{{ value | escape }}</label>
                            {%- else -%}
                              <label for="{{ input_id }}">{{ value | escape }}</label>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'inventory' -%}
              <p class="product__inventory" data-inventory hidden {{ block.shopify_attributes }}></p>
              <script>
                window.productInventory = {
                  {%- for variant in product.variants -%}
                    {%- liquid
                      assign state = 'in'
                      assign text = 'products.product.in_stock' | t
                      if variant.inventory_management == 'shopify'
                        if variant.inventory_quantity <= 0
                          if variant.inventory_policy == 'continue'
                            assign state = 'low'
                            assign text = 'products.product.preorder_shipping' | t
                          else
                            assign state = 'out'
                            assign text = 'products.product.sold_out' | t
                          endif
                        elsif variant.inventory_quantity <= block.settings.low_threshold
                          assign state = 'low'
                          assign text = 'products.product.low_stock' | t: count: variant.inventory_quantity
                        endif
                      endif
                    -%}
                    {{ variant.id | json }}: { state: {{ state | json }}, text: {{ text | json }} }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                };
              </script>

            {%- when 'buy_buttons' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, data-product-form: '', class: 'product__form' -%}
                  <input type="hidden" name="id" value="{% unless must_choose %}{{ current_variant.id }}{% endunless %}">
                  <div class="product__buttons">
                    {%- if block.settings.show_quantity -%}
                      <div class="quantity" style="align-self: flex-start;">
                        <button type="button" data-qty-step="-1" aria-label="{{ 'cart.general.decrease' | t }}">&minus;</button>
                        <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.general.quantity' | t }}">
                        <button type="button" data-qty-step="1" aria-label="{{ 'cart.general.increase' | t }}">+</button>
                      </div>
                    {%- endif -%}
                    <button type="submit" name="add" class="btn btn--full"{% unless current_variant.available or must_choose %} disabled{% endunless %} data-price-in-button="{{ block.settings.show_price }}">
                      <span>
                        {%- if current_variant.available == false and must_choose != true -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- elsif is_preorder -%}
                          {{ 'products.product.preorder' | t }}
                        {%- else -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- endif -%}
                        {%- if block.settings.show_price %} • {{ current_variant.price | money }}{% endif -%}
                      </span>
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                  </div>
                  <p class="product__error" data-product-error role="alert"></p>
                {%- endform -%}
              </div>

            {%- when 'shipping_box' -%}
              <div class="product__shipping-box" {{ block.shopify_attributes }}>
                <p class="product__shipping-box-title">
                  {%- if block.settings.show_flag -%}
                    {{ localization.country | image_url: width: 32 | image_tag: class: 'product__flag', alt: localization.country.name }}
                  {%- endif -%}
                  {{ block.settings.title | replace: '[pais]', localization.country.name | upcase }}
                </p>
                {%- if block.settings.text != blank -%}
                  <p class="product__shipping-box-text">
                    {%- render 'icon', icon: 'return' -%}
                    {{ block.settings.text }}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="rte body-medium" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="rte body-medium" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'collapsible' -%}
              {%- liquid
                assign content = block.settings.content
                if block.settings.page != blank
                  assign content = block.settings.page.content
                endif
                if block.settings.use_description
                  assign content = product.description
                endif
              -%}
              {%- if content != blank -%}
                <details class="product__accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.heading | escape }} {% render 'icon', icon: 'plus' %}</summary>
                  <div class="product__accordion-content rte">{{ content }}</div>
                </details>
              {%- endif -%}

            {%- when 'share' -%}
              <div class="product__share" style="display: flex; gap: 14px; font-size: 0.9em;" {{ block.shopify_attributes }}>
                <span>{{ 'products.product.share' | t }}:</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">Facebook</a>
                <a href="https://pinterest.com/pin/create/button/?url={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">Pinterest</a>
                <a href="https://wa.me/?text={{ product.title | append: ' ' | append: request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
              </div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 }},
            "available": {{ variant.available }},
            "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }} }{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Producto",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Marca", "limit": 1 },
    { "type": "title", "name": "Título", "limit": 1 },
    { "type": "price", "name": "Precio", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "Selector de variantes",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_style",
          "label": "Estilo para talla y otras opciones",
          "options": [
            { "value": "dropdown", "label": "Desplegable" },
            { "value": "buttons", "label": "Botones" }
          ],
          "default": "dropdown"
        },
        {
          "type": "checkbox",
          "id": "require_selection",
          "label": "Obligar a elegir talla (\"Selecciona tu talla\")",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "color_swatches",
          "label": "Mostrar colores como círculos",
          "default": true
        }
      ]
    },
    {
      "type": "inventory",
      "name": "Estado de stock",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "low_threshold",
          "label": "Avisar de pocas unidades por debajo de",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Mostrar selector de cantidad",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Mostrar el precio en el botón",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Mostrar botones de pago dinámico",
          "default": false
        }
      ]
    },
    {
      "type": "siblings",
      "name": "Otros colores",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Muestra los productos del metacampo custom.siblings (lista de productos). El texto sale del metacampo custom.color_name."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto si no hay custom.color_name",
          "default": "Colores"
        }
      ]
    },
    {
      "type": "shipping_box",
      "name": "Caja de envío",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "info": "[pais] se sustituye por el país del cliente.",
          "default": "Enviamos a [pais]"
        },
        {
          "type": "checkbox",
          "id": "show_flag",
          "label": "Mostrar bandera",
          "default": true
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Devoluciones en 14 días a través de nuestro portal online"
        }
      ]
    },
    { "type": "description", "name": "Descripción", "limit": 1 },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Texto informativo</p>"
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Desplegable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Envíos y devoluciones"
        },
        {
          "type": "checkbox",
          "id": "use_description",
          "label": "Mostrar la descripción del producto",
          "default": false
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido",
          "default": "<p>Envíos en 2-5 días laborables. Devoluciones gratuitas en 14 días.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Contenido desde una página"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Abierto por defecto",
          "default": false
        }
      ]
    },
    { "type": "share", "name": "Compartir", "limit": 1 }
  ]
}
{% endschema %}
