<div class="account account--wide">
  <h1 class="heading-small">{{ 'customer.account.title' | t }}</h1>
  <p class="text-center" style="margin-bottom: 30px;">
    <a href="{{ routes.account_logout_url }}" class="btn btn--text">{{ 'customer.account.logout' | t }}</a>
  </p>
  <div class="account-grid">
    <div>
      <h2 class="heading-x-small" style="margin-bottom: 14px;">{{ 'customer.account.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="account-table">
            <thead>
              <tr>
                <th>{{ 'customer.order.number' | t }}</th>
                <th>{{ 'customer.order.date' | t }}</th>
                <th>{{ 'customer.order.status' | t }}</th>
                <th>{{ 'customer.order.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" style="text-decoration: underline;">{{ order.name }}</a></td>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.account.no_orders' | t }}</p>
        {%- endif -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    </div>
    <div>
      <h2 class="heading-x-small" style="margin-bottom: 14px;">{{ 'customer.account.details' | t }}</h2>
      <p>{{ customer.name }}<br>{{ customer.email }}</p>
      {{ customer.default_address | format_address }}
      <p style="margin-top: 14px;">
        <a href="{{ routes.account_addresses_url }}" class="btn btn--text">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Cuenta", "class": "section-main-account", "settings": [] }
{% endschema %}
