<div class="password-page">
  <div class="password-page__inner">
    {%- if section.settings.logo != blank -%}
      <div style="width: 140px; margin: 0 auto;">
        {{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name }}
      </div>
    {%- else -%}
      <h1 class="header__logo-text">{{ shop.name }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="search-popdown__form">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'general.newsletter.email' | t }}</label>
          <input type="email" id="PasswordNewsletter" name="contact[email]" placeholder="{{ 'general.newsletter.email' | t }}" required>
          <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details>
      <summary style="cursor: pointer;">{{ 'general.password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" style="margin-top: 14px;">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="search-popdown__form" style="margin-top: 14px;">
          <label class="visually-hidden" for="Password">{{ 'general.password.label' | t }}</label>
          <input type="password" id="Password" name="password" placeholder="{{ 'general.password.label' | t }}" autocomplete="current-password">
          <button type="submit" class="btn">{{ 'general.password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Contraseña",
  "class": "section-main-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}
