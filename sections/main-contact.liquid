<div class="page-header">
  <h1 class="heading-small">{{ page.title | escape }}</h1>
</div>
<div class="wrapper--narrow page-content">
  {%- if page.content != blank -%}
    <div class="rte body-medium" style="margin-bottom: 30px;">{{ page.content }}</div>
  {%- endif -%}
  {%- form 'contact', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message">{{ 'contact.form.success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="ContactName">{{ 'contact.form.name' | t }}</label>
      <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name">
    </div>
    <div class="field">
      <label for="ContactEmail">{{ 'contact.form.email' | t }} *</label>
      <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required autocomplete="email">
    </div>
    <div class="field">
      <label for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
      <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
    </div>
    <div class="field">
      <label for="ContactMessage">{{ 'contact.form.message' | t }}</label>
      <textarea id="ContactMessage" name="contact[body]">{{ form.body }}</textarea>
    </div>
    <button type="submit" class="btn">{{ 'contact.form.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Formulario de contacto",
  "class": "section-main-contact",
  "settings": []
}
{% endschema %}
